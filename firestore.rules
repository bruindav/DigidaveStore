rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Voorbeeldkeuze van DigidaveStore: iedereen mag lezen, alleen Dave mag wijzigen
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'davedebruin123@gmail.com'
                   && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
